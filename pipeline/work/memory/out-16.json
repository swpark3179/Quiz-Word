    "story": "규칙에 맞서(of) 들이받은(fend) 사람(-er) → 위반자",
    "family": ["defend", "offense", "fence"]
  },
  "offer": {
    "roots": [{ "part": "of-", "ko": "~앞으로 (ob)" }, { "part": "fer", "ko": "나르다" }],
    "origin": "라틴어 offerre (앞에 가져다 놓다)",
