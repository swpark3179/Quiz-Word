{
  "no-longer": {
    "roots": [{ "part": "no", "ko": "아니" }, { "part": "longer", "ko": "더 오래" }],
    "story": "전에는 그랬지만 지금부터 더 오래(longer)는 아니다(no) → 더 이상 ~ 않다"
  },
  "noise": {
    "origin": "고대 프랑스어 noise (소란, 시끄러움)",
    "story": "시끄러운 잡음에 정작 들어야 할 소리가 묻힌다 → 노이즈, 핵심을 가리는 쓸모없는 정보",
    "hook": "노이즈 → 사진·음향에 끼는 '노이즈'(잡음) → 쓸모없는 정보"
  },
  "non-blocking": {
    "roots": [{ "part": "non-", "ko": "아닌" }, { "part": "block", "ko": "막다" }, { "part": "-ing", "ko": "~하는" }],
    "story": "오류가 나도 길을 막아(block) 세우지 않는(non) → 막지 않는, 비차단의"
  },
  "non-unique": {
    "roots": [{ "part": "non-", "ko": "아닌" }, { "part": "unique", "ko": "하나뿐인" }],
    "origin": "unique ← 라틴어 unicus (하나뿐인)",
    "story": "하나뿐(unique)이 아니라(non) 같은 것이 여럿 걸리는 → 고유하지 않은",
    "family": ["unit", "union", "uniform"]
  },
  "none": {
    "roots": [{ "part": "n-", "ko": "아니 (not)" }, { "part": "one", "ko": "하나" }],
    "origin": "고대 영어 nān (ne 아니 + ān 하나)",
    "story": "하나(one)도 아니다(n-) → 아무것도 ~ 않다, 하나도 ~ 않다",
    "family": ["neither", "never", "nothing"]
  },
  "nor": {
    "origin": "중세 영어 nother (neither) 의 줄임",
    "story": "or(또는) 앞에 부정의 n이 얹힌 모양, 앞엣것도 아니고 뒤엣것도 아니다 → A도 B도 아니다",
    "family": ["neither", "never", "none"]
  },
  "normalize": {
    "roots": [{ "part": "norm", "ko": "기준, 표준" }, { "part": "-al", "ko": "~의" }, { "part": "-ize", "ko": "~하게 만들다" }],
    "origin": "라틴어 norma (목수의 직각자, 기준)",
    "story": "제각각인 형식을 직각자(norm) 같은 기준에 맞게 만든다(-ize) → 표준 형태로 맞추다, 정규화하다",
    "hook": "노멀라이즈 → '노멀'(정상·표준) 상태로 만든다 → 정규화하다",
    "family": ["norm", "normal", "abnormal", "enormous"]
  },
  "note": {
    "origin": "라틴어 nota (표시, 기호)",
    "story": "눈여겨볼 곳에 표시(nota)를 해 둔다 → 주목하다, 언급하다 / 메모",
    "hook": "노트 → 공책 '노트'에 적어 둘 만한 것 → 주목하다, 메모",
    "family": ["notable", "notation", "annotate", "denote"]
  },
  "notice": {
    "roots": [{ "part": "not", "ko": "알다" }, { "part": "-ice", "ko": "~함 (명사)" }],
    "origin": "라틴어 notitia (알려짐) ← noscere (알다)",
    "story": "눈에 띄어 알게(not) 된다 → 알아차리다 / 모두가 알게 하는 글 → 공지, 통지",
    "hook": "노티스 → 게시판 '공지(Notice)' → 공지, 알아차리다",
    "family": ["notify", "notion", "notorious"]
  },
  "nowhere": {
    "roots": [{ "part": "no", "ko": "없는" }, { "part": "where", "ko": "어디, 곳" }],
    "story": "그런 곳(where)은 없다(no) → 어디에도 ~ 없다",
    "family": ["nobody", "nothing", "somewhere", "anywhere"]
  },
  "null": {
    "origin": "라틴어 nullus (하나도 없는) ← ne + ullus",
    "story": "어떤 것(ullus)도 없어(ne) 칸이 비어 있다 → 값이 없음, 널",
    "hook": "널 → 텅 비어 '널널한' 자리 → 값이 없음",
    "family": ["nullify", "annul"]
  },
  "numeric": {
    "roots": [{ "part": "numer", "ko": "수" }, { "part": "-ic", "ko": "~의" }],
    "origin": "라틴어 numerus (수)",
    "story": "글자가 아니라 수(numer)로 이루어진 → 숫자의, 수치로 된",
    "family": ["number", "numeral", "numerous", "enumerate"]
  },
  "oauth": {
    "origin": "Open Authorization",
    "story": "비밀번호를 넘기지 않고 토큰으로 권한 부여(Authorization)를 열어(Open) 준다 → 권한 위임 표준 OAuth"
  },
  "object": {
    "roots": [{ "part": "ob-", "ko": "~앞에, 맞서" }, { "part": "ject", "ko": "던지다" }],
    "origin": "라틴어 obicere (앞에 던지다)",
    "story": "눈앞에(ob) 던져져(ject) 놓인 것 → 물체, 대상, 객체 / 맞서(ob) 던지면 → 반대하다",
    "family": ["project", "reject", "inject", "subject"]
  },
  "observe": {
    "roots": [{ "part": "ob-", "ko": "~을 향해" }, { "part": "serve", "ko": "지켜보다, 지키다" }],
