  },
  "optional": {
    "roots": [{ "part": "opt", "ko": "고르다" }, { "part": "-ion", "ko": "~하는 것" }, { "part": "-al", "ko": "~의" }],
    "origin": "라틴어 optio (선택) ← optare (고르다)",
    "story": "해도 되고 안 해도 되게 고르는(opt) 사람 마음에 맡긴 → 선택적인, 필수가 아닌",
    "family": ["opt", "option", "adopt"]
  },
  "orchestration": {
