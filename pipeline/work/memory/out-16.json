    "family": ["preserve", "conserve", "reserve"]
  },
  "occupy": {
    "roots": [{ "part": "oc-", "ko": "~을 향해 (ob)" }, { "part": "cup", "ko": "잡다" }, { "part": "-y", "ko": "동사 어미" }],
    "origin": "라틴어 occupare (붙잡다, 차지하다)",
    "story": "빈자리를 꽉 잡아(cup) 제 것으로 깔고 앉는다 → (공간을) 차지하다",
    "family": ["capture", "capable", "occupant"]
  },
  "offender": {
    "roots": [{ "part": "of-", "ko": "~에 맞서 (ob)" }, { "part": "fend", "ko": "치다" }, { "part": "-er", "ko": "~하는 사람" }],
