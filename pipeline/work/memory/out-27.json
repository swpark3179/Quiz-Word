{
  "variable": {
    "roots": [{ "part": "vari", "ko": "바뀌다, 가지각색" }, { "part": "-able", "ko": "~할 수 있는" }],
    "origin": "라틴어 variabilis (바뀔 수 있는)",
    "story": "담긴 값이 바뀔(vari) 수 있는(-able) 것 → 변수 / 변하기 쉬운, 가변적인",
    "family": ["vary", "various", "variety"]
  },
  "variant": {
    "roots": [{ "part": "vari", "ko": "바뀌다, 가지각색" }, { "part": "-ant", "ko": "~하는 것" }],
    "origin": "라틴어 varians (바뀌는) ← variare (바꾸다)",
    "story": "원래 것에서 조금 바뀐(vari) 것(-ant) → 변형, (조금씩 다른) 버전",
    "family": ["variation", "variety", "variance"]
  },
  "vary": {
    "origin": "라틴어 variare (바꾸다) ← varius (가지각색의)",
    "story": "가지각색(varius)으로 저마다 달라진다 → (서로) 다르다, 달라지다",
    "hook": "베리 → '버라이어티 쇼'는 갖가지로 달라지는 쇼 → 달라지다, 다르다",
    "family": ["various", "variety", "variable"]
  },
  "vcs": {
    "origin": "Version Control System",
    "story": "파일의 버전(Version)을 관리(Control)하는 시스템(System) → 버전 관리 시스템"
  },
  "vehicle": {
    "roots": [{ "part": "vehi", "ko": "나르다" }, { "part": "-cle", "ko": "~하는 도구" }],
    "origin": "라틴어 vehiculum (나르는 도구) ← vehere (나르다)",
    "story": "사람과 짐을 실어 나르는(vehi) 도구(-cle) → 차량, 탈것 / (목적 달성의) 수단",
    "family": ["vector", "convection"]
  },
  "vendor": {
    "roots": [{ "part": "vend", "ko": "팔다" }, { "part": "-or", "ko": "~하는 사람" }],
    "origin": "라틴어 vendere (팔다)",
    "story": "우리에게 물건을 파는(vend) 쪽(-or) → 판매업체, 공급업체",
    "hook": "벤더 → 유통업계의 '벤더사' → 공급업체, 판매업체",
    "family": ["vend", "venal"]
  },
  "verb": {
    "origin": "라틴어 verbum (말, 낱말)",
    "story": "문장의 중심이 되는 '말(verbum)' → 동사",
    "family": ["verbal", "adverb", "proverb", "verbose"]
  },
  "verification": {
    "roots": [{ "part": "veri", "ko": "참, 진실" }, { "part": "-fic", "ko": "만들다" }, { "part": "-ation", "ko": "~하는 일" }],
    "origin": "중세 라틴어 verificare (참임을 밝히다)",
    "story": "참(veri)임을 분명하게 만드는(fic) 일(-ation) → 검증, 확인",
    "family": ["verify", "verdict", "very", "veracity"]
  },
  "version": {
    "roots": [{ "part": "vers", "ko": "돌리다, 바꾸다" }, { "part": "-ion", "ko": "~한 것" }],
    "origin": "라틴어 versio (돌림, 바꿈) ← vertere (돌리다)",
    "story": "한 번 돌려(vers) 바꿔 낸 것(-ion) 하나하나 → 버전, 판 / 다른 서술",
    "hook": "버전 → '최신 버전' → 판, 버전",
    "family": ["convert", "reverse", "diverse", "versatile"]
  },
  "version-controlled": {
    "roots": [{ "part": "version", "ko": "판, 버전" }, { "part": "controlled", "ko": "관리되는" }],
    "story": "고칠 때마다 버전(version)이 남도록 관리되는(controlled) → 버전 관리되는"
  },
  "via": {
    "origin": "라틴어 via (길) — '~의 길로'",
    "story": "'어디어디라는 길(via)을 지나서' → ~을 통해, ~을 거쳐",
    "hook": "비아 → 기차표 '서울 via 대전'은 대전 경유 → ~을 거쳐",
    "family": ["trivial", "obvious", "deviate", "previous"]
  },
  "violate": {
    "roots": [{ "part": "viol", "ko": "힘으로 범하다" }, { "part": "-ate", "ko": "~하다" }],
    "origin": "라틴어 violare (힘으로 범하다)",
    "story": "그어 놓은 선을 힘으로 짓밟고(viol) 넘는다(-ate) → 어기다, 위반하다",
    "family": ["violence", "violent", "inviolable"]
  },
  "visibility": {
    "roots": [{ "part": "vis", "ko": "보다" }, { "part": "-ibil-", "ko": "~할 수 있는 (-ible)" }, { "part": "-ity", "ko": "~한 정도" }],
    "origin": "라틴어 visibilis (볼 수 있는) ← videre (보다)",
    "story": "속을 들여다볼(vis) 수 있는(-ibil) 정도(-ity) → 가시성",
    "family": ["vision", "visit", "revise"]
  },
  "visible": {
    "roots": [{ "part": "vis", "ko": "보다" }, { "part": "-ible", "ko": "~할 수 있는" }],
    "origin": "라틴어 visibilis (볼 수 있는) ← videre (보다)",
    "story": "눈으로 볼(vis) 수 있는(-ible) → 보이는, 드러나 있는",
    "family": ["vision", "visual", "supervise"]
  },
  "visually": {
    "roots": [{ "part": "vis", "ko": "보다" }, { "part": "-ual", "ko": "~에 관한" }, { "part": "-ly", "ko": "~하게" }],
    "story": "눈으로 보는(vis) 것에 관해(-ual), 그런 면에서(-ly) → 시각적으로, 눈으로 보기에",
    "hook": "비주얼리 → '비주얼이 좋다'의 비주얼(보이는 모습) → 시각적으로",
    "family": ["vision", "visible", "television"]
  },
  "volunteer": {
    "roots": [{ "part": "volunt", "ko": "의지, 제 뜻" }, { "part": "-eer", "ko": "~하는 사람" }],
    "origin": "라틴어 voluntarius (제 뜻으로 하는) ← voluntas (의지)",
    "story": "시키지 않아도 제 뜻(volunt)으로 나서는 사람(-eer)처럼 → 자진해서 말하다, 먼저 제공하다",
    "hook": "발런티어 → 자원봉사자 '볼런티어'처럼 스스로 나선다 → 자진해서 말하다",
    "family": ["voluntary", "volition", "benevolent"]
  },
  "vote": {
    "origin": "라틴어 votum (서약, 바람)",
    "story": "내 바람(votum)을 표 한 장에 담아 낸다 → 투표(하다)",
    "family": ["vow", "devote", "votive"]
  },
  "warning": {
    "roots": [{ "part": "warn", "ko": "조심시키다" }, { "part": "-ing", "ko": "~하는 것" }],
    "origin": "고대 영어 warnian (조심시키다)",
    "story": "위험하니 조심하라고(warn) 미리 알리는 것(-ing) → 경고, 경고 메시지",
    "hook": "워닝 → 화면에 뜨는 노란 '워닝' 메시지 → 경고"
  },
  "webhook": {
    "roots": [{ "part": "web", "ko": "웹" }, { "part": "hook", "ko": "갈고리" }],
    "story": "웹(web) 주소에 걸어 둔 갈고리(hook), 이벤트가 걸리면 당겨서 알린다 → 웹훅"
  },
  "weigh": {
    "origin": "고대 영어 wegan (들어 올리다, 무게를 달다)",
    "story": "양쪽을 저울에 올려(wegan) 어느 쪽이 무거운지 달아 본다 → 저울질하다, 비교 검토하다",
    "family": ["weight", "outweigh"]
  },
  "weight": {
    "roots": [{ "part": "weigh", "ko": "무게를 달다" }, { "part": "-t", "ko": "~한 것" }],
    "origin": "고대 영어 gewiht (무게) ← wegan (달다)",
    "story": "저울에 달아(weigh) 나온 값(-t) → 무게 / 얼마나 무겁게 칠지 정한 값 → 가중치",
    "hook": "웨이트 → '웨이트 트레이닝'은 무게를 드는 운동 → 무게, 가중치",
    "family": ["weigh", "outweigh", "lightweight"]
  },
  "well-formed": {
    "roots": [{ "part": "well", "ko": "잘, 제대로" }, { "part": "formed", "ko": "모양이 잡힌" }],
    "story": "규칙에 맞게 제대로(well) 모양이 잡힌(formed) → 형식이 올바른, 문법에 맞게 짜인"
  },
  "well-structured": {
    "roots": [{ "part": "well", "ko": "잘, 제대로" }, { "part": "structured", "ko": "짜인, 구조화된" }],
    "story": "뼈대가 제대로(well) 짜인(structured) → 구조가 잘 잡힌, 짜임새 있는"
  },
  "whatever": {
    "roots": [{ "part": "what", "ko": "무엇" }, { "part": "ever", "ko": "언제든, ~든지" }],
    "story": "그것이 무엇(what)이든지(ever) 가리지 않고 → 무엇이든, 어떤 ~이든",
    "family": ["whenever", "wherever", "whichever"]
  },
  "whenever": {
    "roots": [{ "part": "when", "ko": "~할 때" }, { "part": "ever", "ko": "언제든, ~든지" }],
    "story": "그런 때(when)가 언제든(ever) 올 때마다 → ~할 때마다, ~하면 언제든",
    "family": ["whatever", "wherever", "whichever"]
  },
  "wherever": {
    "roots": [{ "part": "where", "ko": "~하는 곳" }, { "part": "ever", "ko": "언제든, ~든지" }],
    "story": "그런 곳(where)이면 어디든지(ever) → ~하는 곳이면 어디서나",
    "family": ["whatever", "whenever", "whichever"]
  },
  "whether": {
    "origin": "고대 영어 hwæther (둘 중 어느 쪽)",
    "story": "이쪽인가 저쪽인가, 둘 중 어느 쪽(hwæther)인가 → ~인지 (아닌지), ~이든 아니든",
    "family": ["either", "neither"]
  },
  "whichever": {
    "roots": [{ "part": "which", "ko": "어느 것" }, { "part": "ever", "ko": "언제든, ~든지" }],
    "story": "여럿 중 어느 것(which)을 고르든지(ever) → 어느 것이든, 어느 ~이든",
    "family": ["whatever", "whenever", "wherever"]
  },
  "whose": {
    "origin": "고대 영어 hwæs (who 의 소유격)",
    "story": "누구(who)의 것인지 묻거나, 앞에 나온 대상의 것임을 잇는 꼴 → 누구의, 그것의 ~가"
  },
  "widely-used": {
    "roots": [{ "part": "widely", "ko": "널리" }, { "part": "used", "ko": "쓰이는" }],
    "story": "넓은(wide) 범위에서 두루 쓰이는(used) → 널리 쓰이는"
  },
  "within": {
    "roots": [{ "part": "with", "ko": "~에 붙어, 곁에" }, { "part": "in", "ko": "안" }],
    "origin": "고대 영어 withinnan (안쪽에)",
    "story": "경계선에 붙어(with) 그 안쪽(in)에 머문다 → ~ 안에서, ~ 이내에",
    "family": ["without", "withdraw"]
  },
  "worker": {
    "roots": [{ "part": "work", "ko": "일하다" }, { "part": "-er", "ko": "~하는 자" }],
    "story": "맡겨진 일(work)을 대신 해내는 자(-er) → 워커, 노동자"
  },
  "workflow": {
    "roots": [{ "part": "work", "ko": "일, 작업" }, { "part": "flow", "ko": "흐름" }],
    "story": "일(work)이 단계에서 단계로 흘러가는(flow) 길 → 워크플로, 작업 흐름"
  },
  "workload": {
    "roots": [{ "part": "work", "ko": "일, 작업" }, { "part": "load", "ko": "짐, 부하" }],
    "story": "짊어져야 할 일(work)의 짐(load) → 작업량, 부하"
  },
  "worktree": {
    "roots": [{ "part": "work", "ko": "작업" }, { "part": "tree", "ko": "디렉터리 트리" }],
    "story": "브랜치마다 따로 두는, 작업(work)하는 파일들의 디렉터리 트리(tree) → 워크트리"
  },
  "wrap": {
    "story": "선물을 포장지로 싸듯 앞뒤를 둘러 감는다 → 감싸다, 둘러싸다",
    "hook": "랩 → 음식을 싸는 주방 '랩' → 감싸다"
  },
  "wrapper": {
    "roots": [{ "part": "wrap", "ko": "감싸다" }, { "part": "-er", "ko": "~하는 것" }],
    "story": "기존 기능을 겉에서 감싸(wrap) 동작을 덧붙이는 것(-er) → 래퍼"
  },
  "wrongly": {
    "roots": [{ "part": "wrong", "ko": "틀린, 그릇된" }, { "part": "-ly", "ko": "~하게" }],
    "origin": "고대 노르드어 rangr (비뚤어진) → wrong",
    "story": "비뚤어져 틀린(wrong) 쪽으로(-ly) → 잘못하여, 부당하게"
  },
  "yet": {
    "origin": "고대 영어 gīet (아직, 지금까지)",
    "story": "지금 이 순간까지도 그대로 → 아직 / 그런데도 여전히 → 그러나, 그런데도"
  },
  "zdr": {
    "origin": "Zero Data Retention",
    "story": "데이터(Data)를 보관(Retention)하는 양이 0(Zero) → 데이터 무보존"
  },
  "zod": {
    "story": "들어온 값이 선언한 스키마에 맞는지 문지기처럼 검사해 주는 도구 → 스키마 검증 라이브러리(Zod)"
  }
}
