{
  "cli": {
    "origin": "Command-Line Interface",
    "story": "명령(Command)을 한 줄(Line)씩 쳐 넣어 쓰는 접점(Interface) → 명령줄 인터페이스"
  },
  "client": {
    "origin": "라틴어 cliens (유력자에게 의지하는 사람)",
    "story": "유력자에게 의지해 도움을 청하던 사람(cliens), 서버에 요청하는 쪽 → 클라이언트, 고객"
  },
  "clone": {
    "origin": "그리스어 klōn (잔가지)",
